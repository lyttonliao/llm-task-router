# Copy this file to .env and fill in real values for your machine.
# Loaded by llm_task_router/env_config.py on `import llm_task_router` -
# resolved next to the installed package, not your shell's cwd, so it
# applies regardless of which directory you run llm-chat/llm-route from.
# Existing shell-exported values always take priority over this file.

# Postgres connection string for the tier-2 vector store (routing_examples)
# and the drift/shadow audit log (routing_decisions). See
# llm_task_router/db/schema.sql for the schema this expects.
DATABASE_URL=postgresql:///llm_task_router

# Avoids a network round-trip to Hugging Face Hub on every process start to
# check for a newer sentence-transformers model revision, once the model is
# already cached locally - see README.md's tier-2 seeding section.
#
# Leave this commented out until AFTER your first successful call that
# reaches tier 2 (e.g. scripts/seed_vector_store.py) - with nothing cached
# yet, HF_HUB_OFFLINE=1 makes that first call fail outright (no local cache
# for "offline mode" to fall back to). Uncomment once
# ~/.cache/huggingface/ is populated.
# HF_HUB_OFFLINE=1
